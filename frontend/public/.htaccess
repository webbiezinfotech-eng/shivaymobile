# SPA routing for Hostinger (React Router)
# Ye frontend/dist ke saath public_html me jata hai.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Real files/folders ko chhodo
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Service worker / manifest kabhi rewrite na ho
  RewriteRule ^(sw\.js|workbox-.*\.js|manifest\.webmanifest)$ - [L]

  # Baaki sab index.html par (deep link /sameer, /owner/reports etc.)
  RewriteRule ^ index.html [L]
</IfModule>

# Purana service worker cache na atke
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|workbox-.*\.js|index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|jpeg|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
